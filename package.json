{
  "name": "history-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "check": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/accounts.ts seed",
    "db:seed-tests": "tsx scripts/demo-tests.ts",
    "account": "tsx scripts/accounts.ts",
    "worker": "tsx src/modules/generation/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx tests/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@prisma/adapter-pg": "~7.7.0",
    "@prisma/client": "~7.7.0",
    "better-auth": "~1.6.0",
    "dotenv": "^17.0.0",
    "next": "~16.2.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "~7.7.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0"
  }
}
